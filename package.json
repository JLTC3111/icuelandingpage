{
  "name": "icue-landingpage-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-locales.mjs",
    "dev": "vite --host 127.0.0.1 --port 5188",
    "prebuild": "node scripts/generate-locales.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5188",
    "sync:content": "node scripts/sync-content.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs && node scripts/generate-locales.mjs",
    "videos:optimize": "node scripts/optimize-videos.mjs",
    "test": "node --test tests/*.test.js",
    "test:performance": "npm run build && node tests/performance.browser.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide-react": "1.24.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.62.1",
    "vite": "6.4.5"
  },
  "overrides": {
    "rollup": "4.62.3"
  }
}
